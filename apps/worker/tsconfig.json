{
  "compilerOptions": {
    "target": "ES2022",
    // DOM hace falta por pipeline/poster.ts: el callback de
    // page.waitForFunction() referencia `document`, pero corre dentro
    // del Chromium headless de Puppeteer, no en este proceso de Node.
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
